# Wait a minimum of 2 days before installing a newly published package version.
# This gives time for a bad or compromised release to be found and pulled.
min-release-age = 2

# Exempt our own packages (CSpell, its libraries and dictionaries, and other
# Street Side Software packages), so they update right away.
min-release-age-exclude=@cspell/*,@streetsidesoftware/*,cspell,cspell-*,inject-markdown
